#convert_panic_to_exception
#unstable(template_types)

type<T> Box<dyn ::std::future::Future<Output = T>> {
    #layout(size = 16, align = 8);
    fn into_pin(self) -> ::std::pin::Pin<Box<dyn ::std::future::Future<Output = T>>>;
}
type<T> ::std::pin::Pin<Box<dyn ::std::future::Future<Output = T>>> {
    #layout(size = 16, align = 8);
}

type Box<dyn ::std::future::Future<Output = ()>> {}
type ::std::pin::Pin<Box<dyn ::std::future::Future<Output = ()>>> {}

type Box<dyn ::std::future::Future<Output = i32>> {}
type ::std::pin::Pin<Box<dyn ::std::future::Future<Output = i32>>> {}

type Box<dyn ::std::future::Future<Output = u64>> {}
type ::std::pin::Pin<Box<dyn ::std::future::Future<Output = u64>>> {}

type Box<dyn ::std::future::Future<Output = ::std::string::String>> {}
type ::std::pin::Pin<Box<dyn ::std::future::Future<Output = ::std::string::String>>> {}

type ::std::string::String {
    #layout(size = 24, align = 8);
}

type ::std::time::Duration {
    #layout(size = 16, align = 8);
    fn from_millis(u64) -> ::std::time::Duration;
}

mod crate {
    fn block_on(&self, Box<dyn ::std::future::Future<Output = i32>>) -> i32;
    fn block_on(&self, Box<dyn ::std::future::Future<Output = u64>>) -> u64;
    fn block_on(&self, Box<dyn ::std::future::Future<Output = ()>>);

    async fn pend_x(u64) -> u64;
}
